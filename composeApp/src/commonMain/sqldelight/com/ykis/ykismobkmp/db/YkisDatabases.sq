-- Таблица районов
CREATE TABLE raionEntity (
    raionId INTEGER  NOT NULL PRIMARY KEY,
    raion TEXT NOT NULL DEFAULT ''
);

CREATE TABLE houseEntity (
    houseId INTEGER  NOT NULL PRIMARY KEY,
    raionId INTEGER  NOT NULL,
    house TEXT NOT NULL
);

CREATE TABLE apartmentEntity (
    addressId INTEGER NOT NULL PRIMARY KEY,
    uid TEXT DEFAULT NULL,
    address TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT 'example@email.com',
    kod TEXT NOT NULL DEFAULT '1111111111',
    phone TEXT NOT NULL DEFAULT '+38111111111',
    nanim TEXT NOT NULL DEFAULT 'Иванов Иван Иванович',
    apartmentOrder TEXT NOT NULL DEFAULT '65-2020',
    dataOrder TEXT NOT NULL DEFAULT '1997-11-23',
    -- Вещественные числа (REAL -> Double в Kotlin нативно)
    areaFull REAL NOT NULL DEFAULT 51.00,
    areaLife REAL NOT NULL DEFAULT 31.20,
    areaDop REAL NOT NULL DEFAULT 7.52,
    areaBalk REAL NOT NULL DEFAULT 4.25,
    areaOtopl REAL NOT NULL DEFAULT 51.00,
    -- Все целые числа переведены на чистый INTEGER (Long в Kotlin)
    tenant INTEGER NOT NULL DEFAULT 2,
    podnan INTEGER NOT NULL DEFAULT 0,
    absent INTEGER NOT NULL DEFAULT 1,
    tenantTbo INTEGER NOT NULL DEFAULT 1,
    room INTEGER NOT NULL DEFAULT 2,
    privat INTEGER NOT NULL DEFAULT 1,
    lift INTEGER NOT NULL DEFAULT 1,
    blockId INTEGER NOT NULL DEFAULT 4,
    houseId INTEGER NOT NULL DEFAULT 23,
    fio TEXT NOT NULL DEFAULT 'Иванов Иван Иванович',
    subsidia INTEGER NOT NULL DEFAULT 0,
    vxvoda INTEGER NOT NULL DEFAULT 0,
    teplomer INTEGER NOT NULL DEFAULT 0,
    distributor INTEGER NOT NULL DEFAULT 0,
    kvartplata INTEGER NOT NULL DEFAULT 0,
    otoplenie INTEGER NOT NULL DEFAULT 0,
    ateplo INTEGER NOT NULL DEFAULT 0,
    podogrev INTEGER NOT NULL DEFAULT 0,
    voda INTEGER NOT NULL DEFAULT 0,
    stoki INTEGER NOT NULL DEFAULT 0,
    avoda INTEGER NOT NULL DEFAULT 0,
    astoki INTEGER NOT NULL DEFAULT 0,
    tbo INTEGER NOT NULL DEFAULT 0,
    aggrKv INTEGER NOT NULL DEFAULT 0,
    aggrVoda INTEGER NOT NULL DEFAULT 0,
    aggrTeplo INTEGER NOT NULL DEFAULT 0,
    aggrTbo INTEGER NOT NULL DEFAULT 0,
    boiler INTEGER NOT NULL DEFAULT 0,
    enaudit INTEGER NOT NULL DEFAULT 0,
    heated INTEGER NOT NULL DEFAULT 0,
    ztp INTEGER NOT NULL DEFAULT 0,
    ovu INTEGER NOT NULL DEFAULT 0,
    paused INTEGER NOT NULL DEFAULT 0,
    osmd INTEGER NOT NULL DEFAULT 0,
    osmdId INTEGER NOT NULL DEFAULT 0,
    osbb TEXT DEFAULT NULL,
    whatChange TEXT NOT NULL DEFAULT 'Unknown',
    dataChange TEXT NOT NULL DEFAULT 'Unknown',
    enauditId INTEGER NOT NULL DEFAULT 0,
    -- Тарифная сетка (REAL -> Double в Kotlin нативно)
    tarifKv REAL NOT NULL DEFAULT 0.00,
    tarifOt REAL NOT NULL DEFAULT 0.00,
    tarifAot REAL NOT NULL DEFAULT 0.00,
    tarifGv REAL NOT NULL DEFAULT 0.00,
    tarifXv REAL NOT NULL DEFAULT 0.00,
    tarifSt REAL NOT NULL DEFAULT 0.00,
    tarifTbo REAL NOT NULL DEFAULT 0.00,
    tne REAL NOT NULL DEFAULT 0.00,
    kte REAL NOT NULL DEFAULT 0.00,
    length REAL NOT NULL DEFAULT 0.00,
    diametr REAL NOT NULL DEFAULT 0.00,
    dvodomerId INTEGER NOT NULL DEFAULT 0,
    dteplomerId INTEGER NOT NULL DEFAULT 0,
    operator_ TEXT NOT NULL DEFAULT 'Unknown',
    dataIn TEXT NOT NULL DEFAULT 'Unknown',
    ipay INTEGER NOT NULL DEFAULT 0,
    pb INTEGER NOT NULL DEFAULT 0,
    mtb INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE familyEntity (
    recId INTEGER NOT NULL PRIMARY KEY, -- Наш первичный ключ
    addressId INTEGER NOT NULL,
    rodstvo TEXT NOT NULL DEFAULT 'Unknown',
    firstname TEXT NOT NULL DEFAULT 'Unknown',
    lastname TEXT NOT NULL DEFAULT 'Unknown',
    surname TEXT NOT NULL DEFAULT 'Unknown',
    born TEXT NOT NULL DEFAULT 'Unknown',
    sex TEXT NOT NULL DEFAULT 'Unknown',
    phone TEXT NOT NULL DEFAULT 'Unknown',
    subsidia INTEGER NOT NULL DEFAULT 0,
    vkl INTEGER NOT NULL DEFAULT 0,
    inn TEXT NOT NULL DEFAULT 'Unknown',
    document TEXT NOT NULL DEFAULT 'Unknown',
    seria TEXT NOT NULL DEFAULT 'Unknown',
    nomer TEXT NOT NULL DEFAULT 'Unknown',
    datav TEXT DEFAULT 'Unknown', -- Может быть nullable в домене, оставляем TEXT без NOT NULL
    organ TEXT NOT NULL DEFAULT 'Unknown'
);

CREATE TABLE serviceEntity (
    addressId INTEGER NOT NULL DEFAULT 0,
    service TEXT NOT NULL DEFAULT 'Unknown',
    service1 TEXT DEFAULT 'Unknown',
    service2 TEXT DEFAULT 'Unknown',
    service3 TEXT DEFAULT 'Unknown',
    service4 TEXT DEFAULT 'Unknown',
    dateNach TEXT NOT NULL DEFAULT '2000-01-01',
    -- Задолженность
    zadol REAL DEFAULT 0.0,
    zadol1 REAL DEFAULT 0.0,
    zadol2 REAL DEFAULT 0.0,
    zadol3 REAL DEFAULT 0.0,
    zadol4 REAL DEFAULT 0.0,
    -- Начислено
    nachisleno REAL DEFAULT 0.0,
    nachisleno1 REAL DEFAULT 0.0,
    nachisleno2 REAL DEFAULT 0.0,
    nachisleno3 REAL DEFAULT 0.0,
    nachisleno4 REAL DEFAULT 0.0,
    -- Оплачено
    oplacheno REAL DEFAULT 0.0,
    oplacheno1 REAL DEFAULT 0.0,
    oplacheno2 REAL DEFAULT 0.0,
    oplacheno3 REAL DEFAULT 0.0,
    oplacheno4 REAL DEFAULT 0.0,
    -- Долг
    dolg REAL DEFAULT 0.0,
    dolg1 REAL DEFAULT 0.0,
    dolg2 REAL DEFAULT 0.0,
    dolg3 REAL DEFAULT 0.0,
    dolg4 REAL DEFAULT 0.0,
    PRIMARY KEY (addressId, service, dateNach)
);


CREATE TABLE paymentEntity (
    recId INTEGER  NOT NULL PRIMARY KEY,
    addressId INTEGER  NOT NULL,
    data TEXT NOT NULL DEFAULT 'Unknown',
    kvartplata REAL  NOT NULL DEFAULT 0.0,
    remont REAL  NOT NULL DEFAULT 0.0,
    otoplenie REAL  NOT NULL DEFAULT 0.0,
    voda REAL  NOT NULL DEFAULT 0.0,
    tbo REAL  NOT NULL DEFAULT 0.0,
    summa REAL  NOT NULL DEFAULT 0.0,
    prixod TEXT NOT NULL DEFAULT 'Unknown',
    kassa TEXT NOT NULL DEFAULT 'Unknown',
    nomer TEXT NOT NULL DEFAULT 'Unknown',
    dataIn TEXT NOT NULL DEFAULT 'Unknown'
);


-- Таблица счетчиков тепла
CREATE TABLE heatMeterEntity (
    teplomerId INTEGER  NOT NULL PRIMARY KEY, -- teplomer_id
    number TEXT NOT NULL DEFAULT 'Unknown',        -- nomer
    model TEXT NOT NULL DEFAULT 'Unknown',
    modelId INTEGER  NOT NULL DEFAULT 0,      -- model_id
    addressId INTEGER  NOT NULL DEFAULT 0,    -- address_id
    edizm TEXT NOT NULL DEFAULT 'Unknown',
    koef TEXT NOT NULL DEFAULT 'Unknown',
    area REAL  NOT NULL DEFAULT 0.0,
    sdate TEXT NOT NULL DEFAULT 'Unknown',
    fpdate TEXT NOT NULL DEFAULT 'Unknown',
    pdate TEXT NOT NULL DEFAULT 'Unknown',
    isOut INTEGER  NOT NULL DEFAULT 0,        -- out (зарезервированное слово)
    spisan INTEGER  NOT NULL DEFAULT 0,
    dataSpis TEXT NOT NULL DEFAULT 'Unknown',       -- data_spis
    work INTEGER  NOT NULL DEFAULT 0
);
CREATE TABLE heatReadingEntity (
    addressId INTEGER  NOT NULL,
    pokId INTEGER  NOT NULL PRIMARY KEY, -- pok_id
    teplomerId INTEGER  NOT NULL,
    dateReading TEXT NOT NULL DEFAULT 'Unknown',
    dateOt TEXT NOT NULL DEFAULT '2024-01-01',
    dateDo TEXT NOT NULL DEFAULT '2024-01-01',
    edizm TEXT NOT NULL DEFAULT 'Unknown',
    koef TEXT NOT NULL DEFAULT 'Unknown',
    days INTEGER  NOT NULL DEFAULT 0, -- Short -> Int
    last REAL  NOT NULL DEFAULT 0.0,
    current REAL  NOT NULL DEFAULT 0.0,
    gkal REAL  NOT NULL DEFAULT 0.0,
    avg INTEGER  NOT NULL DEFAULT 0, -- Byte -> Int
    tarif REAL  NOT NULL DEFAULT 0.0,
    qty REAL  NOT NULL DEFAULT 0.0,
    pokOt TEXT NOT NULL DEFAULT 'Unknown',
    pokDo TEXT NOT NULL DEFAULT 'Unknown',
    gkalRasch TEXT NOT NULL DEFAULT 'Unknown',
    gkalDay TEXT NOT NULL DEFAULT 'Unknown',
    qtyDay TEXT NOT NULL DEFAULT 'Unknown',
    dayAvg TEXT NOT NULL DEFAULT 'Unknown',
    dateIn TEXT NOT NULL DEFAULT 'Unknown',
    operator TEXT NOT NULL DEFAULT 'Unknown'
);
CREATE TABLE waterMeterEntity (
    vodomerId INTEGER  NOT NULL PRIMARY KEY, -- vodomer_id
    dvodomerId INTEGER  NOT NULL DEFAULT 0, -- dvodomer_id
    addressId INTEGER  NOT NULL DEFAULT 0,  -- address_id
    nomer TEXT NOT NULL DEFAULT 'Unknown',
    model TEXT NOT NULL DEFAULT 'Unknown',
    st INTEGER  NOT NULL DEFAULT 1,         -- Byte -> Int
    voda TEXT NOT NULL DEFAULT 'Unknown',
    place TEXT NOT NULL DEFAULT 'Unknown',
    position TEXT NOT NULL DEFAULT 'Unknown',
    sdate TEXT NOT NULL DEFAULT 'Unknown',
    fpdate TEXT NOT NULL DEFAULT 'Unknown',
    pdate TEXT NOT NULL DEFAULT 'Unknown',
    pp INTEGER  NOT NULL DEFAULT 0,
    zdate TEXT NOT NULL DEFAULT 'Unknown',
    avg INTEGER  NOT NULL DEFAULT 0,
    spisan INTEGER  NOT NULL DEFAULT 0,
    isOut INTEGER  NOT NULL DEFAULT 0,      -- out (зарезервированное слово)
    paused INTEGER  NOT NULL DEFAULT 0,
    dataSpis TEXT NOT NULL DEFAULT 'Unknown',     -- data_spis
    work INTEGER  NOT NULL DEFAULT 0
);
CREATE TABLE waterReadingEntity (
    addressId INTEGER  NOT NULL,
    pokId INTEGER  NOT NULL PRIMARY KEY, -- pok_id
    vodomerId INTEGER  NOT NULL,         -- vodomer_id
    dateOt TEXT NOT NULL DEFAULT '2024-01-01',
    dateDo TEXT NOT NULL DEFAULT '2024-01-01',
    days INTEGER  NOT NULL DEFAULT 0,
    lastValue INTEGER  NOT NULL DEFAULT 0,    -- last
    currentValue INTEGER  NOT NULL DEFAULT 15, -- current
    kub INTEGER  NOT NULL DEFAULT 0,
    avg INTEGER  NOT NULL DEFAULT 0,          -- Byte -> Int
    pokOt INTEGER  NOT NULL DEFAULT 0,
    pokDo INTEGER  NOT NULL DEFAULT 0,
    rday INTEGER  NOT NULL DEFAULT 0,
    kubDay REAL  NOT NULL DEFAULT 0.0,     -- kub_day
    qtyKub INTEGER  NOT NULL DEFAULT 0,       -- qty_kub
    operator TEXT NOT NULL DEFAULT 'Unknown',       -- data_in_op
    dateReadings TEXT NOT NULL DEFAULT 'Unknown',
    tarifXv REAL  NOT NULL DEFAULT 0.0,
    xvoda REAL  NOT NULL DEFAULT 0.0,
    tarifvSt REAL  NOT NULL DEFAULT 0.0,
    stoki REAL  NOT NULL DEFAULT 0.0,
    dateSt TEXT NOT NULL DEFAULT 'Unknown',
    dateFin TEXT NOT NULL DEFAULT 'Unknown',
    mday INTEGER  NOT NULL DEFAULT 0,
    dateIn TEXT NOT NULL DEFAULT 'Unknown'
);

-- ====================================================================
-- --- 1. DAO RAION (Справочник Районов — Стратегия: Постоянный Кэш) ---
-- ====================================================================

insertRaion:
INSERT OR REPLACE INTO raionEntity VALUES ?;

getRaionList:
SELECT * FROM raionEntity ORDER BY raionId ASC;

deleteAllRaions:
DELETE FROM raionEntity;


-- ====================================================================
-- --- 2. DAO HOUSE (Справочник Домов — Стратегия: Постоянный Кэш) -----
-- ====================================================================

insertHouse:
INSERT OR REPLACE INTO houseEntity VALUES ?;

getHousesByRaion:
SELECT * FROM houseEntity WHERE raionId = :raionId ORDER BY house ASC;

getHouseList:
SELECT * FROM houseEntity;

deleteHousesByRaionId:
DELETE FROM houseEntity WHERE raionId = :raionId;

deleteAllHouses:
DELETE FROM houseEntity;


-- ====================================================================
-- --- 3. DAO APARTMENT (Квартиры — Стратегия: Буфер одного Дома) ------
-- ====================================================================

insertApartment:
INSERT OR REPLACE INTO apartmentEntity VALUES ?;

getApartmentList:
SELECT * FROM apartmentEntity;

getApartmentsByUid:
SELECT * FROM apartmentEntity WHERE uid = :uid;

getFlatById:
SELECT * FROM apartmentEntity WHERE addressId = :addressId;

deleteFlat:
DELETE FROM apartmentEntity WHERE addressId IN (:addressId);

deleteApartmentsByUid:
DELETE FROM apartmentEntity WHERE uid = :uid;

deleteAllApartments:
DELETE FROM apartmentEntity;


-- ====================================================================
-- --- 4. DAO FAMILY (Состав семьи — Стратегия: Чистая Сеть / Буфер) ---
-- ====================================================================

insertFamily:
INSERT OR REPLACE INTO familyEntity VALUES ?;

getFamilyByApartment:
SELECT * FROM familyEntity WHERE addressId = :addressId;

deleteFamilyByAddressId:
DELETE FROM familyEntity WHERE addressId = :addressId;

deleteFamilyByAddressIds:
DELETE FROM familyEntity WHERE addressId IN (:addressIds);

deleteAllFamily:
DELETE FROM familyEntity;


-- ====================================================================
-- --- 5. DAO SERVICE (Начисления — Стратегия: Чистая Сеть / Буфер) ----
-- ====================================================================

-- Инструкция безопасного добавления начислений для маппера addService
insertService:
INSERT OR REPLACE INTO serviceEntity (
    addressId, service, service1, service2, service3, service4, dateNach,
    zadol, zadol1, zadol2, zadol3, zadol4,
    nachisleno, nachisleno1, nachisleno2, nachisleno3, nachisleno4,
    oplacheno, oplacheno1, oplacheno2, oplacheno3, oplacheno4,
    dolg, dolg1, dolg2, dolg3, dolg4
) VALUES ?;

getServiceDetail:
SELECT * FROM serviceEntity
WHERE addressId = :addressId
  AND service = :service
  AND dateNach LIKE :year || '-%'
ORDER BY dateNach DESC;



getTotalDebt:
SELECT * FROM serviceEntity WHERE addressId = :addressId AND service = 'total' LIMIT 1;

deleteServiceByAddressIds:
DELETE FROM serviceEntity WHERE addressId IN (:addressIds);

deleteAllService:
DELETE FROM serviceEntity;


-- ====================================================================
-- --- 6. DAO PAYMENT (Платежи — Стратегия: Чистая Сеть / Буфер) ------
-- ====================================================================

insertPayment:
INSERT OR REPLACE INTO paymentEntity VALUES ?;

getPaymentFromFlat:
SELECT * FROM paymentEntity WHERE addressId = :addressId ORDER BY data DESC;

deletePaymentByAddressIds:
DELETE FROM paymentEntity WHERE addressId IN (:addressIds);

deleteAllPayment:
DELETE FROM paymentEntity;


-- ====================================================================
-- --- 7. DAO METER (Счетчики — Стратегия: Чистая Сеть) ----------------
-- ====================================================================

insertHeatMeter:
INSERT OR REPLACE INTO heatMeterEntity VALUES ?;

insertWaterMeter:
INSERT OR REPLACE INTO waterMeterEntity VALUES ?;

getWaterMetersByApartment:
SELECT * FROM waterMeterEntity WHERE addressId = :addressId ORDER BY work;

getHeatMetersByApartment:
SELECT * FROM heatMeterEntity WHERE addressId = :addressId ORDER BY work;

deleteWaterMetersByApartment:
DELETE FROM waterMeterEntity WHERE addressId = :addressId;

deleteHeatMetersByApartment:
DELETE FROM heatMeterEntity WHERE addressId = :addressId;

deleteAllWaterMeters:
DELETE FROM waterMeterEntity;

deleteAllHeatMeters:
DELETE FROM heatMeterEntity;


-- ====================================================================
-- --- 8. DAO READING (Показания — Стратегия: Чистая Сеть) -------------
-- ====================================================================

insertHeatReading:
INSERT OR REPLACE INTO heatReadingEntity VALUES ?;

insertWaterReading:
INSERT OR REPLACE INTO waterReadingEntity VALUES ?;

getWaterReadingsByMeter:
SELECT * FROM waterReadingEntity WHERE vodomerId = :vodomerId ORDER BY pokId DESC;

getHeatReadingsByMeter:
SELECT * FROM heatReadingEntity WHERE teplomerId = :teplomerId ORDER BY pokId DESC;

getLastWaterReadingByMeter:
SELECT * FROM waterReadingEntity WHERE pokId = :pokId;

getLastHeatReadingByMeter:
SELECT * FROM heatReadingEntity WHERE pokId = :pokId;

deleteWaterReadingsByMeter:
DELETE FROM waterReadingEntity WHERE vodomerId = :vodomerId;

deleteHeatReadingsByMeter:
DELETE FROM heatReadingEntity WHERE teplomerId = :teplomerId;

deleteWaterReadingByPokId:
DELETE FROM waterReadingEntity WHERE pokId = :pokId;

deleteHeatReadingByPokId:
DELETE FROM heatReadingEntity WHERE pokId = :pokId;

deleteAllWaterReadings:
DELETE FROM waterReadingEntity;

deleteAllHeatReadings:
DELETE FROM heatReadingEntity;


-- ====================================================================
-- --- 9. АТОМАРНЫЕ ТРАНЗАКЦИИ ПОЛНОЙ ЗАЧИСТКИ БАЗЫ ДАННЫХ ------------
-- ====================================================================

clearAllTables:
    DELETE FROM apartmentEntity;
    DELETE FROM familyEntity;
    DELETE FROM raionEntity;
    DELETE FROM houseEntity;
    DELETE FROM heatMeterEntity;
    DELETE FROM waterMeterEntity;
    DELETE FROM waterReadingEntity;
    DELETE FROM heatReadingEntity;
    DELETE FROM serviceEntity;
    DELETE FROM paymentEntity;
